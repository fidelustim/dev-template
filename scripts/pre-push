#!/usr/bin/env bash
# Глобальный pre-push (gitflow). Запрещает прямые пуши в main/develop.
# Осознанный обход для релиза:  ALLOW_PROTECTED_PUSH=1 git push origin main
set -uo pipefail
[ "${ALLOW_PROTECTED_PUSH:-0}" = "1" ] && exit 0
protected=" refs/heads/main refs/heads/develop "
blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  case "$protected" in
    *" $remote_ref "*)
      blocked=1
      echo "" >&2
      echo "✗ Прямой пуш в $remote_ref запрещён (gitflow)." >&2
      echo "  Порядок работы:" >&2
      echo "    git checkout -b feature/<ID>-<краткое-имя>" >&2
      echo "    git push -u origin HEAD" >&2
      echo "    gh pr create --base develop --fill" >&2
      echo "  Для релиза (осознанно): ALLOW_PROTECTED_PUSH=1 git push origin $remote_ref" >&2
      ;;
  esac
done
[ "$blocked" = "1" ] && exit 1
exit 0
